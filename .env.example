TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Who may issue commands. Anyone who learns the bot's username can message it,
# so without an allowlist a stranger could run /photo and watch the room.
# Comma-separated numeric user IDs. Defaults to TELEGRAM_CHAT_ID, which for a
# private chat is also the owner's user ID; required if TELEGRAM_CHAT_ID is a
# group (negative), since a group ID is not a user ID.
# TELEGRAM_ALLOWED_USERS=11111111,22222222

# Optional — defaults shown
# CAMERA_INDEX=0
# MOTION_MIN_AREA=3000
# MOTION_COOLDOWN=10
# VIDEO_DURATION=5

# Focus. Continuous autofocus makes the camera refocus on its own, and every
# refocus looks like whole-frame motion. It is off by default; the lens is
# locked at startup to the sharpest position found by a one-shot sweep.
# Set CAMERA_FOCUS (1-1023) to skip that sweep and pin a known-good value —
# the startup log prints the one the sweep picked.
# CAMERA_AUTOFOCUS=false
# CAMERA_FOCUS=300

# False-positive filters. A reading is discarded when sharpness swings by more
# than MOTION_MAX_FOCUS_SHIFT (a refocus or lighting change, not movement) or
# when more than MOTION_MAX_CHANGE_RATIO of the frame changes at once; motion
# must then persist for MOTION_CONSEC_FRAMES readings (~0.1 s each) to alert.
# Lower MOTION_MAX_FOCUS_SHIFT towards 1.3 if refocus alerts still slip past.
# MOTION_MAX_FOCUS_SHIFT=1.6
# MOTION_MAX_CHANGE_RATIO=0.5
# MOTION_CONSEC_FRAMES=3

# Low light. The brightness difference that counts as a changed pixel is
# derived from the noise the camera is actually producing, between MIN and
# MAX, at MARGIN times the measured noise peak. Darkness compresses contrast,
# so a fixed high threshold is what makes a camera blind at night; MAX is the
# old fixed value, so detection can never be less sensitive than before.
# Raise MOTION_NOISE_MARGIN if a noisy night sensor produces false alerts,
# lower MOTION_THRESHOLD_MIN to push sensitivity further.
# MOTION_THRESHOLD_MAX=25
# MOTION_THRESHOLD_MIN=6
# MOTION_NOISE_MARGIN=4.0

# Lets the sensor trade frame rate for exposure time in the dark, so it can
# gather enough light. Set false if you need a guaranteed frame rate.
# CAMERA_LOW_LIGHT=true
