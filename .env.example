TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional — defaults shown
# CAMERA_INDEX=0
# MOTION_MIN_AREA=3000
# MOTION_COOLDOWN=10
# VIDEO_DURATION=5

# Focus. Continuous autofocus makes the camera refocus on its own, and every
# refocus looks like whole-frame motion. It is off by default; the lens is
# locked at startup to the sharpest position found by a one-shot sweep.
# Set CAMERA_FOCUS (1-1023) to skip that sweep and pin a known-good value —
# the startup log prints the one the sweep picked.
# CAMERA_AUTOFOCUS=false
# CAMERA_FOCUS=300

# False-positive filters. A reading is discarded when sharpness swings by more
# than MOTION_MAX_FOCUS_SHIFT (a refocus or lighting change, not movement) or
# when more than MOTION_MAX_CHANGE_RATIO of the frame changes at once; motion
# must then persist for MOTION_CONSEC_FRAMES readings (~0.1 s each) to alert.
# Lower MOTION_MAX_FOCUS_SHIFT towards 1.3 if refocus alerts still slip past.
# MOTION_MAX_FOCUS_SHIFT=1.6
# MOTION_MAX_CHANGE_RATIO=0.5
# MOTION_CONSEC_FRAMES=3
